@namespace Aspire.Dashboard.Components

@*
    A fluent-tooltip rendered next to its anchor instead of through FluentTooltipProvider. FluentTooltip's
    provider shows tooltips as auto popovers, and showing an auto popover light-dismisses any open menu (also
    an auto popover). A manual popover doesn't, so this tooltip can be used on menus and on the buttons that
    open them.
*@
@if (_renderPhase > 0)
{
    <fluent-tooltip class="aspire-tooltip" anchor="@Anchor" positioning="@Positioning" popover="@(_renderPhase > 1 ? "manual" : null)">@Text</fluent-tooltip>
}

@code {
    // Rendering happens in phases:
    // 1. fluent-tooltip only resolves its anchor in connectedCallback, and the anchor (e.g. a FluentButton) may not
    //    be in the DOM yet while the batch that first renders this component is applied. Waiting until after the
    //    first render guarantees the anchor exists when the tooltip connects.
    // 2. The fluent-tooltip template sets popover="" (auto) on the host when it connects, replacing any initial
    //    value. Switching to a manual popover only sticks once the element is connected.
    private int _renderPhase;

    [Parameter, EditorRequired]
    public required string Anchor { get; set; }

    [Parameter]
    public string? Text { get; set; }

    /// <summary>
    /// The fluent-tooltip positioning, e.g. "above", "below", "before" or "after".
    /// </summary>
    [Parameter]
    public string Positioning { get; set; } = "above";

    protected override void OnAfterRender(bool firstRender)
    {
        if (_renderPhase < 2)
        {
            _renderPhase++;
            StateHasChanged();
        }
    }
}
